#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

extension="$(release_extension)"
release_file="$ASDF_DOWNLOAD_PATH/$TOOL_NAME-$ASDF_INSTALL_VERSION.$extension"

# Download the release to the download directory
download_release "$ASDF_INSTALL_VERSION" "$release_file"

# Extract the release into the download directory
case "$extension" in
tar.gz)
  tar -xzf "$release_file" -C "$ASDF_DOWNLOAD_PATH" --strip-components=1 || fail "Could not extract $release_file"
  ;;
zip)
  # The macOS release is a zip holding PlaydateSDK.pkg, whose payload is rooted at PlaydateSDK/
  extract_path="$ASDF_DOWNLOAD_PATH/extract"
  unzip -q "$release_file" -d "$extract_path" || fail "Could not extract $release_file"
  pkgutil --expand-full "$extract_path/PlaydateSDK.pkg" "$extract_path/expanded" || fail "Could not expand PlaydateSDK.pkg"
  cp -R "$extract_path/expanded/PlaydateSDK.pkg/Payload/PlaydateSDK/." "$ASDF_DOWNLOAD_PATH" || fail "Could not copy the Playdate SDK payload"
  rm -rf "$extract_path"
  ;;
esac

# Remove the release file since we don't need to keep it
rm "$release_file"
